# Server-side only — read by the data proxy (vite.config.js / api/td.js), never
# bundled into the client. OPTIONAL: prices & history come from free providers
# (Yahoo / CoinGecko / Frankfurter); the key only unlocks fundamentals
# (valuation, earnings, insiders) via Twelve Data. Get a free key at
# https://twelvedata.com/pricing
TWELVEDATA_KEY=your_twelvedata_api_key

# Server-side only — powers the AI Analyst panel (Claude, Opus 5.5). Optional;
# the rest of the terminal works without it. Get a key at
# https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key
